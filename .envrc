# shellcheck shell=bash
# Pinned nix-direnv so the shell works without a global install. Resolve the
# latest tag: git ls-remote --tags https://github.com/nix-community/nix-direnv
if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi
# Slow shells: add `nix_direnv_manual_reload` above this line and run
# `nix-direnv-reload` after editing flake.nix.
use flake
